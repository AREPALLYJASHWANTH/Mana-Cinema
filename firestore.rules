rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // --- User profile subtree: users/{userId}/profiles/{profileId} ---
    match /users/{userId}/profiles/{profileId} {
      allow read, write: if ownsUser(userId) || isAdmin();

      match /watchlist/{contentId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }

      match /history/{contentId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }

      match /ratings/{contentId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }
    }

    // --- Comments: content_comments/{contentId}/comments/{commentId} ---
    // Client create fields (MovieRepository.addComment): id, contentId, userId,
    // userName, avatarUrl, text, timestamp.
    match /content_comments/{contentId}/comments/{commentId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.contentId == contentId
        && request.resource.data.keys().hasOnly(
             ['id', 'contentId', 'userId', 'userName', 'avatarUrl', 'text', 'timestamp'])
        && request.resource.data.id is string
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 80
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 512
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.timestamp is int;

      // G4: request.resource.data holds the MERGED document after the write, so
      // comparing keys against the doc would deny every real edit. Compare the
      // actual change set instead (affectedKeys of the diff).
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;

      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- Content documents hold rating aggregates; only trusted backends write them ---
    match /movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /webseries/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
